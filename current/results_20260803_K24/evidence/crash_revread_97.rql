STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER STREAM s0, 3/256 TEXTFILE 's0.txt'
DECLARE s1_f0 INTEGER STREAM s1, 3/320 TEXTFILE 's1.txt'
DECLARE s2_f0 INTEGER STREAM s2, 1/200 TEXTFILE 's2.txt'

SELECT * STREAM n0 FROM s1
SELECT * STREAM n1 FROM s1
SELECT * STREAM n2 FROM s0@(4,-3)
SELECT * STREAM n3 FROM s2+n2
SELECT * STREAM n4 FROM s0
