:SUBSTRAT	memory
A(1/10)	/dev/urandom
	a: INTEGER
B(1/5)	/dev/urandom
	b: INTEGER
STREAM_HASH_A_B(1/15)	tail=2
	:- PUSH_STREAM(A)
	:- PUSH_STREAM(B)
	:- STREAM_HASH
	a: INTEGER
		PUSH_ID(STREAM_HASH_A_B[0])
matched(1/15)	tail=5
	:- PUSH_STREAM(STREAM_HASH_A_B)
	:- STREAM_TIMEMOVE(3)
	a: INTEGER
		PUSH_ID(matched[0])
