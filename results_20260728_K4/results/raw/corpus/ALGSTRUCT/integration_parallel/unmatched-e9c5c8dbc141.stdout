:SUBSTRAT	memory
A(1/10)	/dev/urandom
	a: INTEGER
STREAM_TIMEMOVE_A(1/10)	tail=1
	:- PUSH_STREAM(A)
	:- STREAM_TIMEMOVE(1)
	a: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_A[0])
B(1/5)	/dev/urandom
	b: INTEGER
STREAM_TIMEMOVE_B(1/5)	tail=1
	:- PUSH_STREAM(B)
	:- STREAM_TIMEMOVE(1)
	b: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_B[0])
unmatched(1/15)	tail=5
	:- PUSH_STREAM(STREAM_TIMEMOVE_A)
	:- PUSH_STREAM(STREAM_TIMEMOVE_B)
	:- STREAM_HASH
	a: INTEGER
		PUSH_ID(unmatched[0])
