core0(1/10)	datafile1.txt
	a: UINT
core1(1/5)	/dev/urandom
	b: UINT
STREAM_HASH_core0_core1(1/15)	tail=2
	:- PUSH_STREAM(core0)
	:- PUSH_STREAM(core1)
	:- STREAM_HASH
	a: UINT
		PUSH_ID(STREAM_HASH_core0_core1[0])
core2(3/10)	datafile2.txt
	c: UINT
str1(1/15)	tail=2
	:- PUSH_STREAM(STREAM_HASH_core0_core1)
	:- PUSH_STREAM(core2)
	:- STREAM_ADD
	str1_0: INTEGER
		PUSH_ID(str1[0])
str2(1/15)	tail=4
	:- PUSH_STREAM(STREAM_HASH_core0_core1)
	:- STREAM_TIMEMOVE(2)
	str2_0: INTEGER
		PUSH_ID(str2[0])
