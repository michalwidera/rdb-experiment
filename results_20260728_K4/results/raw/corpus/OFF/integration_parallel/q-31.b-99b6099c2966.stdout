core0(1/10)	datafile2.dat
	a: INTEGER
str1(1/10)	tail=2
	:- PUSH_STREAM(core0)
	:- STREAM_TIMEMOVE(2)
	str1_0: INTEGER
		PUSH_ID(str1[0])
		PUSH_VAL(10)
		ADD
	RULE testrule1
		PUSH_ID(str1[0])
		PUSH_VAL(15)
		CMP_LT
		DO DUMP -5 TO 5
	RULE testrule2
		PUSH_ID(str1[0])
		PUSH_VAL(13)
		CMP_EQUAL
		PUSH_ID(str1[0])
		PUSH_VAL(11)
		CMP_EQUAL
		OR
		DO SYSTEM 'echo "systemcall"'
