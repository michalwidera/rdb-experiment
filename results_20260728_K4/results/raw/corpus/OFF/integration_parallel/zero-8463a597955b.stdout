:SUBSTRAT	memory
A(1/10)	/dev/urandom
	a: INTEGER
STREAM_TIMEMOVE_A(1/10)
	:- PUSH_STREAM(A)
	:- STREAM_TIMEMOVE(0)
	a: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_A[0])
B(1/10)	/dev/urandom
	b: INTEGER
STREAM_TIMEMOVE_B(1/10)
	:- PUSH_STREAM(B)
	:- STREAM_TIMEMOVE(0)
	b: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_B[0])
zero(1/20)	tail=1
	:- PUSH_STREAM(STREAM_TIMEMOVE_A)
	:- PUSH_STREAM(STREAM_TIMEMOVE_B)
	:- STREAM_HASH
	a: INTEGER
		PUSH_ID(zero[0])
