:SUBSTRAT	memory
s1(1/1)	data1.dat
	a: INTEGER
s2(1/1)	data2.dat
	b: INTEGER
mysum(1/1)
	:- PUSH_STREAM(s1)
	:- PUSH_STREAM(s2)
	:- STREAM_ADD
	mysum_0: INTEGER
		PUSH_ID(mysum[0])
	mysum_1: INTEGER
		PUSH_ID(mysum[1])
STREAM_ADD_s1_s2(1/1)
	:- PUSH_STREAM(s1)
	:- PUSH_STREAM(s2)
	:- STREAM_ADD
	s1_0: INTEGER
		PUSH_ID(STREAM_ADD_s1_s2[0])
	s2_1: INTEGER
		PUSH_ID(STREAM_ADD_s1_s2[1])
out(1/1)	tail=1
	:- PUSH_STREAM(STREAM_ADD_s1_s2)
	:- STREAM_TIMEMOVE(1)
	out_0: INTEGER
		PUSH_ID(out[0])
