core(1/10)	datafile.txt
	a: INTEGER
	b: INTEGER
	c: INTEGER
serial4(1/10)	tail=1
	:- PUSH_STREAM(core)
	:- STREAM_AGSE(3,2)
	core_0: INTEGER
		PUSH_ID(serial4[0])
	core_1: INTEGER
		PUSH_ID(serial4[1])
serial5(1/10)	tail=1
	:- PUSH_STREAM(core)
	:- STREAM_AGSE(3,3)
	core_0: INTEGER
		PUSH_ID(serial5[0])
	core_1: INTEGER
		PUSH_ID(serial5[1])
	core_2: INTEGER
		PUSH_ID(serial5[2])
serial6(1/10)	tail=1
	:- PUSH_STREAM(core)
	:- STREAM_AGSE(3,-3)
	core_0: INTEGER
		PUSH_ID(serial6[0])
	core_1: INTEGER
		PUSH_ID(serial6[1])
	core_2: INTEGER
		PUSH_ID(serial6[2])
