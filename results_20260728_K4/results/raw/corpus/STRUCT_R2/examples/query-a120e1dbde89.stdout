core1(1/10)	datafile1.dat
	a: BYTE
core2(1/5)	datafile2.txt
	b: INTEGER
	c: FLOAT
str1(1/10)
	:- PUSH_STREAM(core1)
	:- PUSH_STREAM(core2)
	:- STREAM_ADD
	core1_0: BYTE
		PUSH_ID(str1[0])
	core2_1: INTEGER
		PUSH_ID(str1[1])
	core2_2: FLOAT
		PUSH_ID(str1[2])
str2(1/10)
	:- PUSH_STREAM(str1)
	str2_0: INTEGER
		PUSH_ID(str2[1])
