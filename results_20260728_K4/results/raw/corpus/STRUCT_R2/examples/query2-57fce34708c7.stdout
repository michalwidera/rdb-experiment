core0(1/10)	file1.txt
	a: INTEGER
	b: INTEGER
core1(1/5)	file2.txt
	c: INTEGER
	d: INTEGER
pomnozone(1/10)
	:- PUSH_STREAM(core0)
	:- PUSH_STREAM(core1)
	:- STREAM_ADD
	pomnozone_0: INTEGER
		PUSH_ID(pomnozone[0])
		PUSH_ID(pomnozone[2])
		MULTIPLY
	pomnozone_1: INTEGER
		PUSH_ID(pomnozone[1])
		PUSH_ID(pomnozone[3])
		MULTIPLY
