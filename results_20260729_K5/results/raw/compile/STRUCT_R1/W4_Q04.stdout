:STORAGE	temp/
:SUBSTRAT	memory
A(1/10)	a.txt
	value: INTEGER
B(1/5)	b.txt
	value: INTEGER
STREAM_HASH_A_B(1/15)	tail=2
	:- PUSH_STREAM(A)
	:- PUSH_STREAM(B)
	:- STREAM_HASH
	value: INTEGER
		PUSH_ID(STREAM_HASH_A_B[0])
w4_out_000(1/15)	tail=5
	:- PUSH_STREAM(STREAM_HASH_A_B)
	:- STREAM_TIMEMOVE(3)
	w4_out_000_0: INTEGER
		PUSH_ID(w4_out_000[0])
		PUSH_ID(w4_out_000[0])
		MULTIPLY
		PUSH_ID(w4_out_000[0])
		ADD
		PUSH_ID(w4_out_000[0])
		PUSH_ID(w4_out_000[0])
		MULTIPLY
		PUSH_ID(w4_out_000[0])
		ADD
		MULTIPLY
		PUSH_VAL(1000)
		DIVIDE
	w4_out_000_1: INTEGER
		PUSH_ID(w4_out_000[0])
		PUSH_ID(w4_out_000[0])
		ADD
		PUSH_ID(w4_out_000[0])
		PUSH_ID(w4_out_000[0])
		SUBTRACT
		MULTIPLY
