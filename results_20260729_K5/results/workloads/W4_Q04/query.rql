STORAGE 'temp'
SUBSTRAT 'memory'
DECLARE value INTEGER STREAM A, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM B, 1/5 FILE 'b.txt'
SELECT (A[0]*B[0]+A[0])*(A[0]*B[0]+B[0])/1000, (A[0]+B[0])*(A[0]-B[0]) STREAM w4_out_000 FROM (A>2)#(B>1)
SELECT (A[0]*B[0]+A[0])*(A[0]*B[0]+B[0])/1000, (A[0]+B[0])*(A[0]-B[0]) STREAM w4_out_001 FROM (A>2)#(B>1)
SELECT (A[0]*B[0]+A[0])*(A[0]*B[0]+B[0])/1000, (A[0]+B[0])*(A[0]-B[0]) STREAM w4_out_002 FROM (A>2)#(B>1)
SELECT (A[0]*B[0]+A[0])*(A[0]*B[0]+B[0])/1000, (A[0]+B[0])*(A[0]-B[0]) STREAM w4_out_003 FROM (A>2)#(B>1)
