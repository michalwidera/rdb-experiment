:STORAGE	temp/
:SUBSTRAT	memory
A(1/10)	a.txt
	value: INTEGER
STREAM_TIMEMOVE_A(1/10)	tail=2
	:- PUSH_STREAM(A)
	:- STREAM_TIMEMOVE(2)
	value: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_A[0])
B(1/5)	b.txt
	value: INTEGER
STREAM_TIMEMOVE_B(1/5)	tail=1
	:- PUSH_STREAM(B)
	:- STREAM_TIMEMOVE(1)
	value: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_B[0])
w4_out_000(1/15)	tail=5
	:- PUSH_STREAM(STREAM_TIMEMOVE_A)
	:- PUSH_STREAM(STREAM_TIMEMOVE_B)
	:- STREAM_HASH
	value: INTEGER
		PUSH_ID(w4_out_000[0])
w4_p_000(1/15)	tail=5
	:- PUSH_STREAM(w4_out_000)
	w4_p_000_0: INTEGER
		PUSH_ID(w4_p_000[0])
