:STORAGE	temp/
:SUBSTRAT	memory
A(1/10)	a.txt
	value: INTEGER
STREAM_TIMEMOVE_A(1/10)	tail=2
	:- PUSH_STREAM(A)
	:- STREAM_TIMEMOVE(2)
	value: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_A[0])
B(1/5)	b.txt
	value: INTEGER
