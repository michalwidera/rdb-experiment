:STORAGE	temp/
:SUBSTRAT	memory
A(1/10)	a.txt
	value: INTEGER
B(1/5)	b.txt
	value: INTEGER
STREAM_HASH_A_B(1/15)	tail=2
	:- PUSH_STREAM(A)
	:- PUSH_STREAM(B)
	:- STREAM_HASH
	value: INTEGER
		PUSH_ID(STREAM_HASH_A_B[0])
w2_out_000(1/15)	tail=5
	:- PUSH_STREAM(STREAM_HASH_A_B)
	:- STREAM_TIMEMOVE(3)
	value: INTEGER
