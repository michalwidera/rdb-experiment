:STORAGE	temp/
:SUBSTRAT	memory
w5a_000(1/10)	a.txt
	value: INTEGER
w5b_000(1/5)	b.txt
	value: INTEGER
w5_out_000(1/15)	tail=2
	:- PUSH_STREAM(w5a_000)
	:- PUSH_STREAM(w5b_000)
	:- STREAM_HASH
	value: INTEGER
		PUSH_ID(w5_out_000[0])
w5a_001(1/10)	a.txt
	value: INTEGER
w5b_001(1/5)	b.txt
	value: INTEGER
w5_out_001(1/15)	tail=2
	:- PUSH_STREAM(w5a_001)
	:- PUSH_STREAM(w5b_001)
	:- STREAM_HASH
	value: INTEGER
		PUSH_ID(w5_out_001[0])
