STORAGE 'temp'
SUBSTRAT 'memory'
DECLARE value INTEGER STREAM A, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM B, 1/5 FILE 'b.txt'
SELECT * STREAM w4_out_000 FROM (A>2)#(B>1)
SELECT w4_out_000[0] STREAM w4_p_000 FROM w4_out_000
SELECT * STREAM w4_win_000 FROM w4_p_000@(1,30)
SELECT w4_win_000[0] STREAM w4_avg_000 FROM w4_win_000.avg
