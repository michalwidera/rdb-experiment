STORAGE 'temp'
SUBSTRAT 'memory'
DECLARE value INTEGER STREAM A, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM B, 1/5 FILE 'b.txt'
SELECT * STREAM w4_out_000 FROM (A>2)#(B>1)
SELECT w4_out_000[0] STREAM w4_p_000 FROM w4_out_000
SELECT * STREAM w4_win_000 FROM w4_p_000@(1,30)
SELECT w4_win_000[0] STREAM w4_avg_000 FROM w4_win_000.avg
SELECT * STREAM w4_out_001 FROM (A>2)#(B>1)
SELECT w4_out_001[0] STREAM w4_p_001 FROM w4_out_001
SELECT * STREAM w4_win_001 FROM w4_p_001@(1,30)
SELECT w4_win_001[0] STREAM w4_avg_001 FROM w4_win_001.avg
SELECT * STREAM w4_out_002 FROM (A>2)#(B>1)
SELECT w4_out_002[0] STREAM w4_p_002 FROM w4_out_002
SELECT * STREAM w4_win_002 FROM w4_p_002@(1,30)
SELECT w4_win_002[0] STREAM w4_avg_002 FROM w4_win_002.avg
SELECT * STREAM w4_out_003 FROM (A>2)#(B>1)
SELECT w4_out_003[0] STREAM w4_p_003 FROM w4_out_003
SELECT * STREAM w4_win_003 FROM w4_p_003@(1,30)
SELECT w4_win_003[0] STREAM w4_avg_003 FROM w4_win_003.avg
