STORAGE 'temp'
SUBSTRAT 'memory'
DECLARE value INTEGER STREAM w5a_000, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM w5b_000, 1/5 FILE 'b.txt'
DECLARE value INTEGER STREAM w5a_001, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM w5b_001, 1/5 FILE 'b.txt'
DECLARE value INTEGER STREAM w5a_002, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM w5b_002, 1/5 FILE 'b.txt'
DECLARE value INTEGER STREAM w5a_003, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM w5b_003, 1/5 FILE 'b.txt'
DECLARE value INTEGER STREAM w5a_004, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM w5b_004, 1/5 FILE 'b.txt'
DECLARE value INTEGER STREAM w5a_005, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM w5b_005, 1/5 FILE 'b.txt'
DECLARE value INTEGER STREAM w5a_006, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM w5b_006, 1/5 FILE 'b.txt'
DECLARE value INTEGER STREAM w5a_007, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM w5b_007, 1/5 FILE 'b.txt'
SELECT * STREAM w5_out_000 FROM w5a_000#w5b_000
SELECT * STREAM w5_out_001 FROM w5a_001#w5b_001
