STORAGE 'temp'
SUBSTRAT 'memory'
DECLARE value INTEGER STREAM A, 1/10 FILE 'a.txt'
DECLARE value INTEGER STREAM B, 1/5 FILE 'b.txt'
SELECT * STREAM w7_sa FROM A>2
SELECT * STREAM w7_sb FROM B>1
SELECT * STREAM w7_out_000 FROM w7_sa#w7_sb
SELECT * STREAM w7_out_001 FROM w7_sa#w7_sb
SELECT * STREAM w7_out_002 FROM w7_sa#w7_sb
SELECT * STREAM w7_out_003 FROM w7_sa#w7_sb
