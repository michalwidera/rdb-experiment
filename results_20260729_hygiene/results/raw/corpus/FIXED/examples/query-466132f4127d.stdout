core0(1/1)	/dev/urandom
	a: BYTE
	b: BYTE
core1(1/2)	/dev/urandom
	c: BYTE
	d: BYTE
str1(1/3)	tail=1
	:- PUSH_STREAM(core0)
	:- PUSH_STREAM(core1)
	:- STREAM_HASH
	str1_0: INTEGER
		PUSH_ID(str1[0])
	str1_1: INTEGER
		PUSH_ID(str1[1])
str2(1/2)
	:- PUSH_STREAM(core1)
	:- PUSH_STREAM(core0)
	:- STREAM_ADD
	str2_0: INTEGER
		PUSH_ID(str2[0])
		PUSH_VAL(2)
		DIVIDE
		PUSH_VAL(1)
		ADD
	str2_1: INTEGER
		PUSH_ID(str2[2])
	str2_2: INTEGER
		PUSH_ID(str2[2])
		PUSH_VAL(1)
		ADD
	str2_3: INTEGER
		PUSH_ID(str2[3])
