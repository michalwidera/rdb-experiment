source(1/1)	data.txt
	value: INTEGER
win1(1/1)	tail=3
	:- PUSH_STREAM(source)
	:- STREAM_AGSE(1,3)
	source_0: INTEGER
		PUSH_ID(win1[0])
	source_1: INTEGER
		PUSH_ID(win1[1])
	source_2: INTEGER
		PUSH_ID(win1[2])
mid(1/1)	tail=3
	:- PUSH_STREAM(win1)
	mid_0: INTEGER
		PUSH_ID(mid[0])
win2(1/1)	tail=6
	:- PUSH_STREAM(mid)
	:- STREAM_AGSE(1,3)
	mid_0: INTEGER
		PUSH_ID(win2[0])
	mid_1: INTEGER
		PUSH_ID(win2[1])
	mid_2: INTEGER
		PUSH_ID(win2[2])
win_out(1/1)	tail=6
	:- PUSH_STREAM(win2)
	win_out_0: INTEGER
		PUSH_ID(win_out[0])
	win_out_1: INTEGER
		PUSH_ID(win_out[1])
	win_out_2: INTEGER
		PUSH_ID(win_out[2])
