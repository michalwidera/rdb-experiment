core0(1/10)	datafile1.txt
	a: UINT
str1(1/10)
	:- PUSH_STREAM(core0)
	str1_0: INTEGER
		PUSH_ID(str1[0])
core1(1/10)	datafile2.txt
	a: UINT
str2(1/10)
	:- PUSH_STREAM(core0)
	:- PUSH_STREAM(core1)
	:- STREAM_ADD
	str2_0: INTEGER
		PUSH_ID(str2[0])
str3(1/20)	tail=1
	:- PUSH_STREAM(str1)
	:- PUSH_STREAM(str2)
	:- STREAM_HASH
	str3_0: INTEGER
		PUSH_ID(str3[0])
STREAM_ADD_core1_core0(1/10)
	:- PUSH_STREAM(core1)
	:- PUSH_STREAM(core0)
	:- STREAM_ADD
	core1_0: UINT
		PUSH_ID(STREAM_ADD_core1_core0[0])
	core0_1: UINT
		PUSH_ID(STREAM_ADD_core1_core0[1])
str4(1/10)	tail=2
	:- PUSH_STREAM(STREAM_ADD_core1_core0)
	:- STREAM_TIMEMOVE(2)
	str4_0: INTEGER
		PUSH_ID(str4[0])
