	:- PUSH_STREAM(STREAM_HASH_QA2_QB2)
	:- STREAM_TIMEMOVE(3)
	value: INTEGER
		PUSH_ID(multi_reference[0])
CA2(1/10)	p.txt
	cax: INTEGER
	cay: INTEGER
CB2(1/5)	q.txt
	cbx: INTEGER
	cby: INTEGER
STREAM_HASH_CA2_CB2(1/15)	tail=2
	:- PUSH_STREAM(CA2)
	:- PUSH_STREAM(CB2)
	:- STREAM_HASH
	cax: INTEGER
		PUSH_ID(STREAM_HASH_CA2_CB2[0])
	cay: INTEGER
