DB2(1/10)	b.txt
	value: INTEGER
DA2(1/10)	a.txt
	value: INTEGER
A(1/10)	a.txt
	value: INTEGER
B(1/5)	b.txt
	value: INTEGER
STREAM_SELECT_commuted(1/10)
	:- PUSH_STREAM(B)
	:- PUSH_STREAM(A)
	:- STREAM_ADD
	commuted_0: INTEGER
		PUSH_ID(STREAM_SELECT_commuted[1])
		PUSH_ID(STREAM_SELECT_commuted[0])
		MULTIPLY
same1(1/10)
	:- PUSH_STREAM(STREAM_SELECT_commuted)
	same1_0: INTEGER
		PUSH_ID(same1[0])
DA(1/10)	a.txt
	value: INTEGER
MA2(1/10)	a.txt
	value: INTEGER
DB(1/10)	b.txt
	value: INTEGER
STREAM_TIMEMOVE_MA2(1/10)	tail=2
	:- PUSH_STREAM(MA2)
	:- STREAM_TIMEMOVE(2)
	value: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_MA2[0])
dedup_owner(1/10)
	:- PUSH_STREAM(DA)
	:- PUSH_STREAM(DB)
	:- STREAM_ADD
	DA_0: INTEGER
		PUSH_ID(dedup_owner[0])
	DB_1: INTEGER
		PUSH_ID(dedup_owner[1])
dedup_shifted(1/10)	tail=1
	:- PUSH_STREAM(dedup_owner)
	:- STREAM_TIMEMOVE(1)
	dedup_shifted_0: INTEGER
		PUSH_ID(dedup_shifted[0])
	dedup_shifted_1: INTEGER
		PUSH_ID(dedup_shifted[1])
mixed_shift(1/10)	tail=2
	:- PUSH_STREAM(STREAM_TIMEMOVE_MA)
	:- PUSH_STREAM(MB)
	:- STREAM_ADD
	STREAM_TIMEMOVE_MA_0: INTEGER
		PUSH_ID(mixed_shift[0])
	MB_1: INTEGER
		PUSH_ID(mixed_shift[1])
same2(1/10)
	:- PUSH_STREAM(STREAM_SELECT_commuted)
	same2_0: INTEGER
		PUSH_ID(same2[0])
commuted(1/10)
	:- PUSH_STREAM(STREAM_SELECT_commuted)
	commuted_0: INTEGER
		PUSH_ID(commuted[0])
dedup_reference_owner(1/10)
	:- PUSH_STREAM(DA2)
	:- PUSH_STREAM(DB2)
	:- STREAM_ADD
	DA2_0: INTEGER
		PUSH_ID(dedup_reference_owner[0])
	DB2_1: INTEGER
		PUSH_ID(dedup_reference_owner[1])
MB2(1/5)	b.txt
	value: INTEGER
mixed_shift_reference(1/10)	tail=2
	:- PUSH_STREAM(STREAM_TIMEMOVE_MA2)
	:- PUSH_STREAM(MB2)
	:- STREAM_ADD
	STREAM_TIMEMOVE_MA2_0: INTEGER
		PUSH_ID(mixed_shift_reference[0])
	MB2_1: INTEGER
		PUSH_ID(mixed_shift_reference[1])
dedup_reference(1/10)	tail=1
	:- PUSH_STREAM(dedup_reference_owner)
	:- STREAM_TIMEMOVE(1)
	dedup_reference_0: INTEGER
		PUSH_ID(dedup_reference[0])
	dedup_reference_1: INTEGER
		PUSH_ID(dedup_reference[1])
