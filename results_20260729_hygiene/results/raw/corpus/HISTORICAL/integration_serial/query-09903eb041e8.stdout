		PUSH_ID(STREAM_HASH_MA_MB[0])
mixed_hash(1/15)	tail=5
	:- PUSH_STREAM(STREAM_HASH_MA_MB)
	:- STREAM_TIMEMOVE(3)
	value: INTEGER
		PUSH_ID(mixed_hash[0])
