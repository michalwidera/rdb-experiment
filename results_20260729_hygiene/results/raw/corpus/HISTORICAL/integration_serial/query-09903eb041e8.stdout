multi2(1/15)	tail=5
	:- PUSH_STREAM(STREAM_HASH_QA_QB)
	:- STREAM_TIMEMOVE(3)
	value: INTEGER
		PUSH_ID(multi2[0])
STREAM_TIMEMOVE_CA(1/10)	tail=2
	:- PUSH_STREAM(CA)
	:- STREAM_TIMEMOVE(2)
	cax: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_CA[0])
	cay: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_CA[1])
STREAM_TIMEMOVE_CB(1/5)	tail=1
	:- PUSH_STREAM(CB)
	:- STREAM_TIMEMOVE(1)
	cbx: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_CB[0])
	cby: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_CB[1])
collide_user(1/15)	tail=5
	:- PUSH_STREAM(STREAM_TIMEMOVE_CA)
	:- PUSH_STREAM(STREAM_TIMEMOVE_CB)
	:- STREAM_HASH
	cax: INTEGER
		PUSH_ID(collide_user[0])
	cay: INTEGER
		PUSH_ID(collide_user[1])
factor_reference(1/15)	tail=5
	:- PUSH_STREAM(STREAM_HASH_FA2_FB2)
	:- STREAM_TIMEMOVE(3)
	value: INTEGER
		PUSH_ID(factor_reference[0])
