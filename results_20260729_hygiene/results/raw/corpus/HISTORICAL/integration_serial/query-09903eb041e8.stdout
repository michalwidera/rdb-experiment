	cax: INTEGER
	cay: INTEGER
CB(1/5)	q.txt
	cbx: INTEGER
	cby: INTEGER
STREAM_HASH_CA_CB(1/15)	tail=2
	:- PUSH_STREAM(CA)
	:- PUSH_STREAM(CB)
	:- STREAM_HASH
	STREAM_HASH_CA_CB_0: INTEGER
		PUSH_ID(STREAM_HASH_CA_CB[1])
	STREAM_HASH_CA_CB_1: INTEGER
		PUSH_ID(STREAM_HASH_CA_CB[0])
QA(1/10)	a.txt
	value: INTEGER
QB(1/5)	b.txt
	value: INTEGER
STREAM_HASH_QA_QB(1/15)	tail=2
	:- PUSH_STREAM(QA)
	:- PUSH_STREAM(QB)
