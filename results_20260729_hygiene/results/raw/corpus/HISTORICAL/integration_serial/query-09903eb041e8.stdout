:STORAGE	temp/
:SUBSTRAT	memory
FA(1/10)	a.txt
	value: INTEGER
FB(1/5)	b.txt
	value: INTEGER
STREAM_HASH_FA_FB(1/15)	tail=2
	:- PUSH_STREAM(FA)
	:- PUSH_STREAM(FB)
	:- STREAM_HASH
	value: INTEGER
		PUSH_ID(STREAM_HASH_FA_FB[0])
factored(1/15)	tail=5
	:- PUSH_STREAM(STREAM_HASH_FA_FB)
	:- STREAM_TIMEMOVE(3)
	value: INTEGER
		PUSH_ID(factored[0])
MA(1/10)	a.txt
	value: INTEGER
MB(1/5)	b.txt
	value: INTEGER
STREAM_HASH_MA_MB(1/15)	tail=2
