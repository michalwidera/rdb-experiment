:SUBSTRAT	memory
A(1/10)	datafile1.txt
	value: INTEGER
B(1/5)	datafile2.txt
	value: INTEGER
STREAM_HASH_A_B(1/15)	tail=2
	:- PUSH_STREAM(A)
	:- PUSH_STREAM(B)
	:- STREAM_HASH
	value: INTEGER
		PUSH_ID(STREAM_HASH_A_B[0])
matched(1/15)	tail=5
	:- PUSH_STREAM(STREAM_HASH_A_B)
	:- STREAM_TIMEMOVE(3)
	value: INTEGER
		PUSH_ID(matched[0])
A2(1/10)	datafile1.txt
	value: INTEGER
B2(1/5)	datafile2.txt
	value: INTEGER
STREAM_HASH_A2_B2(1/15)	tail=2
	:- PUSH_STREAM(A2)
	:- PUSH_STREAM(B2)
	:- STREAM_HASH
	value: INTEGER
		PUSH_ID(STREAM_HASH_A2_B2[0])
CC(1/15)	tail=5
	:- PUSH_STREAM(STREAM_HASH_A2_B2)
	:- STREAM_TIMEMOVE(3)
	value: INTEGER
		PUSH_ID(CC[0])
