:STORAGE	temp/
A(1/10)	f3_a2.txt
	value: INTEGER
	aux: INTEGER
B(1/5)	f3_b2.txt
	value: INTEGER
	aux: INTEGER
STREAM_HASH_A_B(1/15)	tail=2
	:- PUSH_STREAM(A)
	:- PUSH_STREAM(B)
	:- STREAM_HASH
	value: INTEGER
		PUSH_ID(STREAM_HASH_A_B[0])
	aux: INTEGER
		PUSH_ID(STREAM_HASH_A_B[1])
f3_mix(1/15)	tail=5
	:- PUSH_STREAM(STREAM_HASH_A_B)
	:- STREAM_TIMEMOVE(3)
	value: INTEGER
		PUSH_ID(f3_mix[0])
	aux: INTEGER
		PUSH_ID(f3_mix[1])
f3_win(1/30)	tail=40
	:- PUSH_STREAM(f3_mix)
	:- STREAM_AGSE(1,30)
	f3_mix_0: INTEGER
		PUSH_ID(f3_win[0])
