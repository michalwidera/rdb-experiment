STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER, s0_f2 INTEGER, s0_f3 INTEGER STREAM s0, 1/100 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER, s1_f2 INTEGER, s1_f3 INTEGER STREAM s1, 147/1000 FILE 's1.txt'

SELECT * STREAM n0 FROM s1&441/1000
SELECT * STREAM n1 FROM n0&1029/2000
SELECT * STREAM n2 FROM n1&9261/16000
SELECT * STREAM n3 FROM n2&27783/16000
SELECT * STREAM n4 FROM n3&83349/8000
SELECT * STREAM n5 FROM s1&343/1000
