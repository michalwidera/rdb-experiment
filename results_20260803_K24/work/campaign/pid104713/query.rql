STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 1/4 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 147/1000 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER STREAM s2, 147/1000 FILE 's2.txt'

SELECT * STREAM n0 FROM s2-147/250
SELECT * STREAM n1 FROM n0%441/500
SELECT * STREAM n2 FROM s1.min
SELECT * STREAM n3 FROM n0&147/125
SELECT * STREAM n4 FROM s0%7/12
