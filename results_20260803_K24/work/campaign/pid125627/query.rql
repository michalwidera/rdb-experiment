STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 1/10 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 1/8 FILE 's1.txt'

SELECT * STREAM n0 FROM s0-1/10
SELECT * STREAM n1 FROM n0-1/5
SELECT * STREAM n2 FROM s0&4/15
SELECT * STREAM n3 FROM n2-2/5
SELECT * STREAM n4 FROM n1@(4,3)
SELECT * STREAM n5 FROM s1>1
