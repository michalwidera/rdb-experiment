STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 1 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 1/4 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER STREAM s2, 147/1000 FILE 's2.txt'

SELECT * STREAM n0 FROM s2#s1
SELECT * STREAM n1 FROM s1#n0
SELECT * STREAM n2 FROM n1-147/544
SELECT * STREAM n3 FROM n1
