STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 3/320 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 3/160 FILE 's1.txt'

SELECT * STREAM n0 FROM s0-1/40
SELECT * STREAM n1 FROM s1#n0
SELECT * STREAM n2 FROM n0>1
SELECT * STREAM n3 FROM s1#s0
SELECT * STREAM n4 FROM n3#n2
