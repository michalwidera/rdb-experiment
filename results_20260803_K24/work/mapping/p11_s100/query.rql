STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 1/50 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 1/50 FILE 's1.txt'

SELECT * STREAM n0 FROM s1>2
SELECT * STREAM n1 FROM n0#s1
SELECT * STREAM n2 FROM n0
SELECT * STREAM n3 FROM n2@(1,-2)
SELECT * STREAM n4 FROM s0
