STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER STREAM s0, 3/200 FILE 's0.txt'
DECLARE s1_f0 INTEGER STREAM s1, 9/1600 FILE 's1.txt'
DECLARE s2_f0 INTEGER STREAM s2, 1/200 FILE 's2.txt'

SELECT * STREAM n0 FROM s2+s0
SELECT * STREAM n1 FROM s1+s2
SELECT * STREAM n2 FROM n1+s2
SELECT * STREAM n3 FROM n0+s2
SELECT * STREAM n4 FROM s0+n2
