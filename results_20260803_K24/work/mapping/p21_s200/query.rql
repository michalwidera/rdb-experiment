STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER, s0_f2 INTEGER, s0_f3 INTEGER STREAM s0, 1/40 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER, s1_f2 INTEGER, s1_f3 INTEGER STREAM s1, 1/80 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER, s2_f2 INTEGER, s2_f3 INTEGER STREAM s2, 1/50 FILE 's2.txt'

SELECT * STREAM n0 FROM s1@(3,-4)
SELECT * STREAM n1 FROM s0@(4,4)
SELECT * STREAM n2 FROM s2@(4,-2)
SELECT * STREAM n3 FROM s2@(4,-2)
SELECT * STREAM n4 FROM n3@(3,-4)
SELECT * STREAM n5 FROM s2@(1,4)
