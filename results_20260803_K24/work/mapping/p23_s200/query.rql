STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER, s0_f2 INTEGER STREAM s0, 647/100000 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER, s1_f2 INTEGER STREAM s1, 647/117600 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER, s2_f2 INTEGER STREAM s2, 647/14700 FILE 's2.txt'

SELECT * STREAM n0 FROM s2#s0
SELECT * STREAM n1 FROM s2#n0
SELECT * STREAM n2 FROM s0@(3,4)
