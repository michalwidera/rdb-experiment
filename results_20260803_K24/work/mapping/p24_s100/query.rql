STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 4/125 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 1/50 FILE 's1.txt'

SELECT * STREAM n0 FROM s1>3
SELECT * STREAM n1 FROM s1>5
SELECT * STREAM n2 FROM n0-1/20
SELECT * STREAM n3 FROM n1>3
SELECT * STREAM n4 FROM n1@(2,-2)
SELECT * STREAM n5 FROM n1#n0
