STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER, s0_f2 INTEGER STREAM s0, 1/50 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER, s1_f2 INTEGER STREAM s1, 1/100 FILE 's1.txt'

SELECT * STREAM n0 FROM s1>1
SELECT * STREAM n1 FROM s0+n0
SELECT * STREAM n2 FROM n1.max
SELECT * STREAM n3 FROM s1@(4,-3)
SELECT * STREAM n4 FROM n0+s1
SELECT * STREAM n5 FROM n0
