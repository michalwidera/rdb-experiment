STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER STREAM s0, 17/500 FILE 's0.txt'
DECLARE s1_f0 INTEGER STREAM s1, 17/400 FILE 's1.txt'
DECLARE s2_f0 INTEGER STREAM s2, 17/1000 FILE 's2.txt'

SELECT * STREAM n0 FROM s1#s2
SELECT * STREAM n1 FROM s2#n0
SELECT * STREAM n2 FROM s2#n1
SELECT * STREAM n3 FROM n0#s0
