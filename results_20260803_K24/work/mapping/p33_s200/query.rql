STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 1/20 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 1/200 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER STREAM s2, 1/125 FILE 's2.txt'

SELECT * STREAM n0 FROM s1&1/80
SELECT * STREAM n1 FROM n0&1/40
SELECT * STREAM n2 FROM n0&1/45
