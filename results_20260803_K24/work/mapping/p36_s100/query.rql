STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER, s0_f2 INTEGER, s0_f3 INTEGER STREAM s0, 1/100 FILE 's0.txt'

SELECT * STREAM n0 FROM s0.avg
SELECT * STREAM n1 FROM s0.max
SELECT * STREAM n2 FROM s0.min
SELECT * STREAM n3 FROM s0.min
SELECT * STREAM n4 FROM s0.max
SELECT * STREAM n5 FROM s0.avg
