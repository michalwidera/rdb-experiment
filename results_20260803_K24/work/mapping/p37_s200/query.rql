STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER STREAM s0, 1/200 FILE 's0.txt'
DECLARE s1_f0 INTEGER STREAM s1, 1/200 FILE 's1.txt'
DECLARE s2_f0 INTEGER STREAM s2, 3/200 FILE 's2.txt'

SELECT * STREAM n0 FROM s1@(2,1)
SELECT * STREAM n1 FROM s2
SELECT * STREAM n2 FROM n0-1/25
SELECT * STREAM n3 FROM s2#n2
SELECT * STREAM n4 FROM n1
SELECT * STREAM n5 FROM n3
