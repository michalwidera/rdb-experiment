STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER, s0_f2 INTEGER, s0_f3 INTEGER STREAM s0, 441/50000 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER, s1_f2 INTEGER, s1_f3 INTEGER STREAM s1, 3/200 FILE 's1.txt'

SELECT * STREAM n0 FROM s1>3
SELECT * STREAM n1 FROM n0#s1
SELECT * STREAM n2 FROM n1#s1
