STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER, s0_f2 INTEGER STREAM s0, 107/7500 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER, s1_f2 INTEGER STREAM s1, 107/3200 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER, s2_f2 INTEGER STREAM s2, 107/7500 FILE 's2.txt'

SELECT * STREAM n0 FROM s2%107/5000
SELECT * STREAM n1 FROM s1.min
SELECT * STREAM n2 FROM n0%214/1875
SELECT * STREAM n3 FROM s0#s1
