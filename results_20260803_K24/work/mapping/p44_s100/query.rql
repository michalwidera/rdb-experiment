STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER STREAM s0, 13/200 FILE 's0.txt'
DECLARE s1_f0 INTEGER STREAM s1, 13/150 FILE 's1.txt'

SELECT * STREAM n0 FROM s1#s0
SELECT * STREAM n1 FROM s0#n0
SELECT * STREAM n2 FROM n1#s0
SELECT * STREAM n3 FROM s0#n1
SELECT * STREAM n4 FROM n3#n1
SELECT * STREAM n5 FROM n0#n2
