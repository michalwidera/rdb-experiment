STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER, s0_f2 INTEGER, s0_f3 INTEGER STREAM s0, 5/147 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER, s1_f2 INTEGER, s1_f3 INTEGER STREAM s1, 1/100 FILE 's1.txt'

SELECT * STREAM n0 FROM s0&25/294
SELECT * STREAM n1 FROM s0&10/147
SELECT * STREAM n2 FROM s0&40/441
SELECT * STREAM n3 FROM n0&25/147
SELECT * STREAM n4 FROM s1&1/40
