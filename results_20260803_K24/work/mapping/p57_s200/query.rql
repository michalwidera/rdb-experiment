STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER STREAM s0, 1/125 FILE 's0.txt'
DECLARE s1_f0 INTEGER STREAM s1, 1/200 FILE 's1.txt'
DECLARE s2_f0 INTEGER STREAM s2, 1/60 FILE 's2.txt'

SELECT * STREAM n0 FROM s0>8
SELECT * STREAM n1 FROM s2>2
SELECT * STREAM n2 FROM s0>2
SELECT * STREAM n3 FROM s0>5
