STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER STREAM s0, 1/200 FILE 's0.txt'
DECLARE s1_f0 INTEGER STREAM s1, 1/3 FILE 's1.txt'

SELECT * STREAM n0 FROM s0+s1
SELECT * STREAM n1 FROM s1+n0
SELECT * STREAM n2 FROM n0+n1
SELECT * STREAM n3 FROM s1+n0
SELECT * STREAM n4 FROM n3+s0
SELECT * STREAM n5 FROM n3+s1
