STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER, s0_f2 INTEGER, s0_f3 INTEGER STREAM s0, 1/100 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER, s1_f2 INTEGER, s1_f3 INTEGER STREAM s1, 9/800 FILE 's1.txt'

SELECT * STREAM n0 FROM s1&3/100
SELECT * STREAM n1 FROM n0&27/500
SELECT * STREAM n2 FROM s0&1/50
