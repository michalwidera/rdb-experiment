STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER, s0_f2 INTEGER, s0_f3 INTEGER STREAM s0, 1/160 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER, s1_f2 INTEGER, s1_f3 INTEGER STREAM s1, 1/120 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER, s2_f2 INTEGER, s2_f3 INTEGER STREAM s2, 1/200 FILE 's2.txt'

SELECT * STREAM n0 FROM s1-1/48
SELECT * STREAM n1 FROM s0-3/160
SELECT * STREAM n2 FROM n1-3/64
SELECT * STREAM n3 FROM s2-1/50
SELECT * STREAM n4 FROM n2-3/64
