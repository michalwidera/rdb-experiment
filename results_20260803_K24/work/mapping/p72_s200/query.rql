STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 23/1000 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 23/400 FILE 's1.txt'

SELECT * STREAM n0 FROM s1#s0
SELECT * STREAM n1 FROM s0#n0
SELECT * STREAM n2 FROM n0#s1
SELECT * STREAM n3 FROM n2#n1
SELECT * STREAM n4 FROM n1#n0
SELECT * STREAM n5 FROM n3#s1
