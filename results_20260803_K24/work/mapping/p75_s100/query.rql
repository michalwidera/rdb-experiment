STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 1/100 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 3/128 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER STREAM s2, 1/80 FILE 's2.txt'

SELECT * STREAM n0 FROM s0&7/300
SELECT * STREAM n1 FROM s2&3/80
SELECT * STREAM n2 FROM n0&7/100
SELECT * STREAM n3 FROM s2&1/32
