STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 1/200 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 1/150 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER STREAM s2, 1/150 FILE 's2.txt'

SELECT * STREAM n0 FROM s2%1/50
SELECT * STREAM n1 FROM s2%1/100
SELECT * STREAM n2 FROM s0%3/400
SELECT * STREAM n3 FROM n2%3/100
SELECT * STREAM n4 FROM s1%4/225
SELECT * STREAM n5 FROM s2%4/225
