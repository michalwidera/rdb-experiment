STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 103/20000 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 103/600 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER STREAM s2, 103/500 FILE 's2.txt'

SELECT * STREAM n0 FROM s0#s1
SELECT * STREAM n1 FROM s2>5
SELECT * STREAM n2 FROM n1#s2
