STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER STREAM s0, 1/100 FILE 's0.txt'
DECLARE s1_f0 INTEGER STREAM s1, 1/200 FILE 's1.txt'
DECLARE s2_f0 INTEGER STREAM s2, 1/200 FILE 's2.txt'

SELECT * STREAM n0 FROM s1&7/600
SELECT * STREAM n1 FROM n0&7/400
SELECT * STREAM n2 FROM n1&21/400
SELECT * STREAM n3 FROM s2&1/75
SELECT * STREAM n4 FROM s0&7/300
SELECT * STREAM n5 FROM n1&7/150
