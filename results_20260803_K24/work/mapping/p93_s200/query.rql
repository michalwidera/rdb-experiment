STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER STREAM s0, 5/18 FILE 's0.txt'
DECLARE s1_f0 INTEGER STREAM s1, 1/120 FILE 's1.txt'

SELECT * STREAM n0 FROM s1>5
SELECT * STREAM n1 FROM s1-1/80
SELECT * STREAM n2 FROM n1@(4,-2)
SELECT * STREAM n3 FROM n2@(2,-2)
SELECT * STREAM n4 FROM n1#s1
SELECT * STREAM n5 FROM n1
