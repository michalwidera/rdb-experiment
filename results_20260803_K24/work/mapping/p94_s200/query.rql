STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER STREAM s0, 5/441 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER STREAM s1, 1/200 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER STREAM s2, 2/147 FILE 's2.txt'

SELECT * STREAM n0 FROM s1-3/200
SELECT * STREAM n1 FROM s0>8
SELECT * STREAM n2 FROM n1
SELECT * STREAM n3 FROM n1#n2
