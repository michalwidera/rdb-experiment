STORAGE '.'
SUBSTRAT 'memory'

DECLARE s0_f0 INTEGER, s0_f1 INTEGER, s0_f2 INTEGER STREAM s0, 3/200 FILE 's0.txt'
DECLARE s1_f0 INTEGER, s1_f1 INTEGER, s1_f2 INTEGER STREAM s1, 9/800 FILE 's1.txt'
DECLARE s2_f0 INTEGER, s2_f1 INTEGER, s2_f2 INTEGER STREAM s2, 9/500 FILE 's2.txt'

SELECT * STREAM n0 FROM s2#s0
SELECT * STREAM n1 FROM s0
SELECT * STREAM n2 FROM s0
SELECT * STREAM n3 FROM s0>1
SELECT * STREAM n4 FROM s0@(1,3)
