# F9-R1 — kontrole: Q=1 oraz near-miss z §10, każda na własnym zestawie źródeł.
#
# Kryteria:
#   Q=1            — reguła R1 wolno, żeby odpaliła (przenosi przesunięcie), ale
#                    nie ma drugiej postaci, więc nie ma czego deduplikować;
#                    liczba zapisów substratów zostaje ta sama co bez reguły.
#   niedopasowanie — 2*(1/100) != 2*(1/50), więc STREAM_HASH_MA_MB NIE MOŻE powstać,
#                    a oba substraty przesunięć muszą przetrwać.
#   inne instancje — IA/IB i IA2/IB2 to różne strumienie nad tymi samymi plikami;
#                    dedup NIE MOŻE ich scalić.
#   granica publiczna — strumień publiczny nazwany konwencją kompilatora, o zgodnym
#                    typowo, lecz przestawionym schemacie; reguła nie może go użyć
#                    ponownie (wzorzec collide_user z optimizer_ablation).

STORAGE 'temp'
SUBSTRAT 'memory'

# --- Q=1 ---
DECLARE v INTEGER STREAM QA, 1/100 FILE 'src_a.txt'
DECLARE v INTEGER STREAM QB, 1/50  FILE 'src_b.txt'
SELECT q1[0]*q1[0] STREAM q1 FROM (QA>2)#(QB>1)

# --- near-miss 1: niedopasowane przesunięcie ---
DECLARE v INTEGER STREAM MA, 1/100 FILE 'src_a.txt'
DECLARE v INTEGER STREAM MB, 1/50  FILE 'src_b.txt'
SELECT mm[0]*mm[0] STREAM mm FROM (MA>2)#(MB>2)

# --- near-miss 2: równoważne postacie nad RÓŻNYMI instancjami źródeł ---
DECLARE v INTEGER STREAM IA, 1/100 FILE 'src_a.txt'
DECLARE v INTEGER STREAM IB, 1/50  FILE 'src_b.txt'
DECLARE v INTEGER STREAM IA2, 1/100 FILE 'src_a.txt'
DECLARE v INTEGER STREAM IB2, 1/50  FILE 'src_b.txt'
SELECT i1[0]*i1[0] STREAM i1 FROM (IA>2)#(IB>1)
SELECT i2[0]*i2[0] STREAM i2 FROM (IA2#IB2)>3

# --- near-miss 3: granica obserwowalności (kolizja nazw z konwencją kompilatora) ---
DECLARE cx INTEGER, cy INTEGER STREAM CA, 1/100 FILE 'src_p.txt'
DECLARE cx INTEGER, cy INTEGER STREAM CB, 1/50  FILE 'src_q.txt'
SELECT CA[1],CA[0] STREAM STREAM_HASH_CA_CB FROM CA#CB
SELECT * STREAM collide_user FROM (CA>2)#(CB>1)
