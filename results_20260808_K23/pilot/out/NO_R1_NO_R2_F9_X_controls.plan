:SUBSTRAT	memory
:STORAGE	temp/
QA(1/100)	src_a.txt
	v: INTEGER
STREAM_TIMEMOVE_QA(1/100)	origin=2
	:- PUSH_STREAM(QA)
	:- STREAM_TIMEMOVE(2)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_QA[0])
QB(1/50)	src_b.txt
	v: INTEGER
STREAM_TIMEMOVE_QB(1/50)	origin=1
	:- PUSH_STREAM(QB)
	:- STREAM_TIMEMOVE(1)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_QB[0])
STREAM_HASH_STREAM_TIMEMOVE_QA_STREAM_TIMEMOVE_QB(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_TIMEMOVE_QA)
	:- PUSH_STREAM(STREAM_TIMEMOVE_QB)
	:- STREAM_HASH
	v: INTEGER
		PUSH_ID(STREAM_HASH_STREAM_TIMEMOVE_QA_STREAM_TIMEMOVE_QB[0])
QC(1/100)	src_c.txt
	v: INTEGER
STREAM_TIMEMOVE_QC(1/100)	origin=2
	:- PUSH_STREAM(QC)
	:- STREAM_TIMEMOVE(2)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_QC[0])
QD(1/50)	src_d.txt
	v: INTEGER
STREAM_TIMEMOVE_QD(1/50)	origin=1
	:- PUSH_STREAM(QD)
	:- STREAM_TIMEMOVE(1)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_QD[0])
STREAM_HASH_STREAM_TIMEMOVE_QC_STREAM_TIMEMOVE_QD(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_TIMEMOVE_QC)
	:- PUSH_STREAM(STREAM_TIMEMOVE_QD)
	:- STREAM_HASH
	v: INTEGER
		PUSH_ID(STREAM_HASH_STREAM_TIMEMOVE_QC_STREAM_TIMEMOVE_QD[0])
q1(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_HASH_STREAM_TIMEMOVE_QA_STREAM_TIMEMOVE_QB)
	:- PUSH_STREAM(STREAM_HASH_STREAM_TIMEMOVE_QC_STREAM_TIMEMOVE_QD)
	:- STREAM_ADD
	q1_0: INTEGER
		PUSH_ID(q1[0])
		PUSH_ID(q1[1])
		MULTIPLY
		PUSH_ID(q1[0])
		PUSH_ID(q1[1])
		MULTIPLY
		ADD
		CALL(Sqrt)
HA(1/100)	src_a.txt
	v: INTEGER
STREAM_TIMEMOVE_HA(1/100)	origin=2
	:- PUSH_STREAM(HA)
	:- STREAM_TIMEMOVE(2)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_HA[0])
HB(1/50)	src_b.txt
	v: INTEGER
STREAM_TIMEMOVE_HB(1/50)	origin=1
	:- PUSH_STREAM(HB)
	:- STREAM_TIMEMOVE(1)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_HB[0])
STREAM_HASH_STREAM_TIMEMOVE_HA_STREAM_TIMEMOVE_HB(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_TIMEMOVE_HA)
	:- PUSH_STREAM(STREAM_TIMEMOVE_HB)
	:- STREAM_HASH
	v: INTEGER
		PUSH_ID(STREAM_HASH_STREAM_TIMEMOVE_HA_STREAM_TIMEMOVE_HB[0])
HC(1/100)	src_c.txt
	v: INTEGER
STREAM_TIMEMOVE_HC(1/100)	origin=2
	:- PUSH_STREAM(HC)
	:- STREAM_TIMEMOVE(2)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_HC[0])
HD(1/50)	src_d.txt
	v: INTEGER
STREAM_TIMEMOVE_HD(1/50)	origin=2
	:- PUSH_STREAM(HD)
	:- STREAM_TIMEMOVE(2)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_HD[0])
STREAM_HASH_STREAM_TIMEMOVE_HC_STREAM_TIMEMOVE_HD(1/150)	tail=2	origin=4
	:- PUSH_STREAM(STREAM_TIMEMOVE_HC)
	:- PUSH_STREAM(STREAM_TIMEMOVE_HD)
	:- STREAM_HASH
	v: INTEGER
		PUSH_ID(STREAM_HASH_STREAM_TIMEMOVE_HC_STREAM_TIMEMOVE_HD[0])
h1(1/150)	tail=2	origin=4
	:- PUSH_STREAM(STREAM_HASH_STREAM_TIMEMOVE_HA_STREAM_TIMEMOVE_HB)
	:- PUSH_STREAM(STREAM_HASH_STREAM_TIMEMOVE_HC_STREAM_TIMEMOVE_HD)
	:- STREAM_ADD
	h1_0: INTEGER
		PUSH_ID(h1[0])
		PUSH_ID(h1[1])
		MULTIPLY
		PUSH_ID(h1[0])
		PUSH_ID(h1[1])
		MULTIPLY
		ADD
		CALL(Sqrt)
STREAM_HASH_HA_HB(1/150)	tail=2
	:- PUSH_STREAM(HA)
	:- PUSH_STREAM(HB)
	:- STREAM_HASH
	v: INTEGER
		PUSH_ID(STREAM_HASH_HA_HB[0])
STREAM_HASH_HC_HD(1/150)	tail=2
	:- PUSH_STREAM(HC)
	:- PUSH_STREAM(HD)
	:- STREAM_HASH
	v: INTEGER
		PUSH_ID(STREAM_HASH_HC_HD[0])
STREAM_TIMEMOVE_STREAM_HASH_HA_HB(1/150)	origin=3
	:- PUSH_STREAM(STREAM_HASH_HA_HB)
	:- STREAM_TIMEMOVE(3)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_STREAM_HASH_HA_HB[0])
STREAM_TIMEMOVE_STREAM_HASH_HC_HD(1/150)	origin=3
	:- PUSH_STREAM(STREAM_HASH_HC_HD)
	:- STREAM_TIMEMOVE(3)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_STREAM_HASH_HC_HD[0])
h2(1/150)	origin=3
	:- PUSH_STREAM(STREAM_TIMEMOVE_STREAM_HASH_HC_HD)
	:- PUSH_STREAM(STREAM_TIMEMOVE_STREAM_HASH_HA_HB)
	:- STREAM_ADD
	h2_0: INTEGER
		PUSH_ID(h2[1])
		PUSH_ID(h2[0])
		MULTIPLY
		PUSH_ID(h2[1])
		PUSH_ID(h2[0])
		MULTIPLY
		ADD
		CALL(Sqrt)
