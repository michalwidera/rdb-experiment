# F9-X, Q=8 — plan kampanii K23. Wygenerowany przez gen_corpus.py;
# nie edytować ręcznie (bramka: `gen_corpus.py --check`).
# Postacie czynne przy tym Q: 4 z 4 (W1, W4, W2, W3).

STORAGE 'temp'
SUBSTRAT 'memory'

DECLARE v INTEGER STREAM A, 1/100  FILE 'front_vib.txt'
DECLARE v INTEGER STREAM B, 1/50   FILE 'front_cur.txt'
DECLARE v INTEGER STREAM C, 1/100  FILE 'rear_vib.txt'
DECLARE v INTEGER STREAM D, 1/50   FILE 'rear_cur.txt'

# postać W1
SELECT Sqrt(A[0]*C[0]+B[0]*D[0]) STREAM m1 FROM ((A>2)#(B>1)) + ((C>2)#(D>1))
SELECT Sqrt(A[0]*C[0]+B[0]*D[0]) STREAM m2 FROM ((A>2)#(B>1)) + ((C>2)#(D>1))
# postać W4
SELECT Sqrt(A[0]*C[0]+B[0]*D[0]) STREAM m3 FROM ((C#D)>3) + ((A#B)>3)
SELECT Sqrt(A[0]*C[0]+B[0]*D[0]) STREAM m4 FROM ((C#D)>3) + ((A#B)>3)
# postać W2
SELECT Sqrt(A[0]*C[0]+B[0]*D[0]) STREAM m5 FROM ((C>2)#(D>1)) + ((A>2)#(B>1))
SELECT Sqrt(A[0]*C[0]+B[0]*D[0]) STREAM m6 FROM ((C>2)#(D>1)) + ((A>2)#(B>1))
# postać W3
SELECT Sqrt(A[0]*C[0]+B[0]*D[0]) STREAM m7 FROM ((A#B)>3) + ((C#D)>3)
SELECT Sqrt(A[0]*C[0]+B[0]*D[0]) STREAM m8 FROM ((A#B)>3) + ((C#D)>3)
