:SUBSTRAT	memory
:STORAGE	temp/
A(1/100)	front_vib.txt
	front: INTEGER
B(1/50)	front_cur.txt
	front: INTEGER
STREAM_HASH_A_B(1/150)	tail=2
	:- PUSH_STREAM(A)
	:- PUSH_STREAM(B)
	:- STREAM_HASH
	front: INTEGER
		PUSH_ID(STREAM_HASH_A_B[0])
C(1/100)	rear_vib.txt
	rear: INTEGER
D(1/50)	rear_cur.txt
	rear: INTEGER
STREAM_HASH_C_D(1/150)	tail=2
	:- PUSH_STREAM(C)
	:- PUSH_STREAM(D)
	:- STREAM_HASH
	rear: INTEGER
		PUSH_ID(STREAM_HASH_C_D[0])
STREAM_TIMEMOVE_STREAM_HASH_A_B(1/150)	origin=3
	:- PUSH_STREAM(STREAM_HASH_A_B)
	:- STREAM_TIMEMOVE(3)
	front: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_STREAM_HASH_A_B[0])
STREAM_TIMEMOVE_STREAM_HASH_C_D(1/150)	origin=3
	:- PUSH_STREAM(STREAM_HASH_C_D)
	:- STREAM_TIMEMOVE(3)
	rear: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_STREAM_HASH_C_D[0])
STREAM_SELECT_m1(1/150)	origin=3
	:- PUSH_STREAM(STREAM_TIMEMOVE_STREAM_HASH_A_B)
	:- PUSH_STREAM(STREAM_TIMEMOVE_STREAM_HASH_C_D)
	:- STREAM_ADD
	m1_0: INTEGER
		PUSH_ID(STREAM_SELECT_m1[0])
		PUSH_ID(STREAM_SELECT_m1[0])
		MULTIPLY
		PUSH_ID(STREAM_SELECT_m1[1])
		PUSH_ID(STREAM_SELECT_m1[1])
		MULTIPLY
		ADD
		CALL(Sqrt)
m23(1/150)	origin=3
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m23_0: INTEGER
		PUSH_ID(m23[0])
