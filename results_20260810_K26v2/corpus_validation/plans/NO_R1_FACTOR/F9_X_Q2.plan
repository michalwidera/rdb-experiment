:STORAGE	temp/
:SUBSTRAT	memory
A(1/100)	front_vib.txt
	front: INTEGER
STREAM_TIMEMOVE_A(1/100)	origin=2
	:- PUSH_STREAM(A)
	:- STREAM_TIMEMOVE(2)
	front: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_A[0])
B(1/50)	front_cur.txt
	front: INTEGER
STREAM_TIMEMOVE_B(1/50)	origin=1
	:- PUSH_STREAM(B)
	:- STREAM_TIMEMOVE(1)
	front: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_B[0])
STREAM_HASH_STREAM_TIMEMOVE_A_STREAM_TIMEMOVE_B(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_TIMEMOVE_A)
	:- PUSH_STREAM(STREAM_TIMEMOVE_B)
	:- STREAM_HASH
	front: INTEGER
		PUSH_ID(STREAM_HASH_STREAM_TIMEMOVE_A_STREAM_TIMEMOVE_B[0])
C(1/100)	rear_vib.txt
	rear: INTEGER
STREAM_TIMEMOVE_C(1/100)	origin=2
	:- PUSH_STREAM(C)
	:- STREAM_TIMEMOVE(2)
	rear: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_C[0])
D(1/50)	rear_cur.txt
	rear: INTEGER
STREAM_TIMEMOVE_D(1/50)	origin=1
	:- PUSH_STREAM(D)
	:- STREAM_TIMEMOVE(1)
	rear: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_D[0])
STREAM_HASH_STREAM_TIMEMOVE_C_STREAM_TIMEMOVE_D(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_TIMEMOVE_C)
	:- PUSH_STREAM(STREAM_TIMEMOVE_D)
	:- STREAM_HASH
	rear: INTEGER
		PUSH_ID(STREAM_HASH_STREAM_TIMEMOVE_C_STREAM_TIMEMOVE_D[0])
STREAM_SELECT_m1(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_HASH_STREAM_TIMEMOVE_A_STREAM_TIMEMOVE_B)
	:- PUSH_STREAM(STREAM_HASH_STREAM_TIMEMOVE_C_STREAM_TIMEMOVE_D)
	:- STREAM_ADD
	m1_0: INTEGER
		PUSH_ID(STREAM_SELECT_m1[0])
		PUSH_ID(STREAM_SELECT_m1[0])
		MULTIPLY
		PUSH_ID(STREAM_SELECT_m1[1])
		PUSH_ID(STREAM_SELECT_m1[1])
		MULTIPLY
		ADD
		CALL(Sqrt)
m1(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m1_0: INTEGER
		PUSH_ID(m1[0])
m2(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m2_0: INTEGER
		PUSH_ID(m2[0])
