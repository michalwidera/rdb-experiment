:SUBSTRAT	memory
:STORAGE	temp/
A(1/100)	vib.txt
	v: INTEGER
B(1/50)	cur.txt
	v: INTEGER
STREAM_HASH_A_B(1/150)	tail=2
	:- PUSH_STREAM(A)
	:- PUSH_STREAM(B)
	:- STREAM_HASH
	v: INTEGER
		PUSH_ID(STREAM_HASH_A_B[0])
m11(1/150)	origin=3
	:- PUSH_STREAM(STREAM_HASH_A_B)
	:- STREAM_TIMEMOVE(3)
	m11_0: INTEGER
		PUSH_ID(m11[0])
		PUSH_ID(m11[0])
		MULTIPLY
