:STORAGE	temp/
:SUBSTRAT	memory
A(1/100)	vib.txt
	v: INTEGER
STREAM_TIMEMOVE_A(1/100)	origin=2
	:- PUSH_STREAM(A)
	:- STREAM_TIMEMOVE(2)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_A[0])
B(1/50)	cur.txt
	v: INTEGER
STREAM_TIMEMOVE_B(1/50)	origin=1
	:- PUSH_STREAM(B)
	:- STREAM_TIMEMOVE(1)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_B[0])
m1(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_TIMEMOVE_A)
	:- PUSH_STREAM(STREAM_TIMEMOVE_B)
	:- STREAM_HASH
	m1_0: INTEGER
		PUSH_ID(m1[0])
		PUSH_ID(m1[0])
		MULTIPLY
m2(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_TIMEMOVE_A)
	:- PUSH_STREAM(STREAM_TIMEMOVE_B)
	:- STREAM_HASH
	m2_0: INTEGER
		PUSH_ID(m2[0])
		PUSH_ID(m2[0])
		MULTIPLY
