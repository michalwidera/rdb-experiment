:SUBSTRAT	memory
:STORAGE	temp/
B(1/100)	axis_y.txt
	v: INTEGER
A(1/100)	axis_x.txt
	v: INTEGER
STREAM_SELECT_m10(1/100)
	:- PUSH_STREAM(B)
	:- PUSH_STREAM(A)
	:- STREAM_ADD
	m10_0: INTEGER
		PUSH_ID(STREAM_SELECT_m10[1])
		PUSH_ID(STREAM_SELECT_m10[1])
		MULTIPLY
		PUSH_ID(STREAM_SELECT_m10[0])
		PUSH_ID(STREAM_SELECT_m10[0])
		MULTIPLY
		ADD
		CALL(Sqrt)
m9(1/100)
	:- PUSH_STREAM(STREAM_SELECT_m10)
	m9_0: INTEGER
		PUSH_ID(m9[0])
STREAM_SELECT_m1(1/100)
