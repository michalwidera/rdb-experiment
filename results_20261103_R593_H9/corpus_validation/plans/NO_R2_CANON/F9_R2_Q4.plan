:STORAGE	temp/
:SUBSTRAT	memory
A(1/100)	axis_x.txt
	v: INTEGER
B(1/100)	axis_y.txt
	v: INTEGER
STREAM_SELECT_m1(1/100)
	:- PUSH_STREAM(A)
	:- PUSH_STREAM(B)
	:- STREAM_ADD
	m1_0: INTEGER
		PUSH_ID(STREAM_SELECT_m1[0])
		PUSH_ID(STREAM_SELECT_m1[0])
		MULTIPLY
		PUSH_ID(STREAM_SELECT_m1[1])
		PUSH_ID(STREAM_SELECT_m1[1])
		MULTIPLY
		ADD
		CALL(Sqrt)
m1(1/100)
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m1_0: INTEGER
		PUSH_ID(m1[0])
m2(1/100)
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m2_0: INTEGER
		PUSH_ID(m2[0])
STREAM_SELECT_m3(1/100)
	:- PUSH_STREAM(B)
	:- PUSH_STREAM(A)
	:- STREAM_ADD
	m3_0: INTEGER
		PUSH_ID(STREAM_SELECT_m3[1])
		PUSH_ID(STREAM_SELECT_m3[1])
		MULTIPLY
		PUSH_ID(STREAM_SELECT_m3[0])
		PUSH_ID(STREAM_SELECT_m3[0])
		MULTIPLY
		ADD
		CALL(Sqrt)
m3(1/100)
	:- PUSH_STREAM(STREAM_SELECT_m3)
	m3_0: INTEGER
		PUSH_ID(m3[0])
m4(1/100)
	:- PUSH_STREAM(STREAM_SELECT_m3)
	m4_0: INTEGER
		PUSH_ID(m4[0])
