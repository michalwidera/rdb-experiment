STORAGE 'temp'
SUBSTRAT 'memory'
DECLARE value INTEGER STREAM A, 1/120 TEXTFILE 'a.txt'
DECLARE value INTEGER STREAM B, 1/60 TEXTFILE 'b.txt'
SELECT * STREAM w2_out_000 FROM (A>2)#(B>1)
SELECT * STREAM w2_out_001 FROM (A>2)#(B>1)
SELECT * STREAM w2_out_002 FROM (A>2)#(B>1)
SELECT * STREAM w2_out_003 FROM (A>2)#(B>1)
SELECT * STREAM w2_out_004 FROM (A>2)#(B>1)
SELECT * STREAM w2_out_005 FROM (A>2)#(B>1)
SELECT * STREAM w2_out_006 FROM (A>2)#(B>1)
SELECT * STREAM w2_out_007 FROM (A>2)#(B>1)
