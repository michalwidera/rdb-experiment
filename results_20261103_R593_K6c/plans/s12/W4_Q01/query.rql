STORAGE 'temp'
SUBSTRAT 'memory'
DECLARE value INTEGER STREAM A, 1/120 TEXTFILE 'a.txt'
DECLARE value INTEGER STREAM B, 1/60 TEXTFILE 'b.txt'
SELECT * STREAM w4_out_000 FROM (A>2)#(B>1)
SELECT w4_out_000[0] STREAM w4_p_000 FROM w4_out_000
SELECT * STREAM w4_win_000 FROM w4_p_000@(1,30)
SELECT to_integer(w4_win_000[0]) STREAM w4_avg_000 FROM AVG(w4_win_000)
