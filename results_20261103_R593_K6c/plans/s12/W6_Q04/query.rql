STORAGE 'temp'
SUBSTRAT 'memory'
DECLARE value INTEGER STREAM A, 1/120 TEXTFILE 'a.txt'
DECLARE value INTEGER STREAM B, 1/60 TEXTFILE 'b.txt'
SELECT * STREAM w6_out_000 FROM (A>1)#(B>1)
SELECT * STREAM w6_out_001 FROM (A>1)#(B>1)
SELECT * STREAM w6_out_002 FROM (A>1)#(B>1)
SELECT * STREAM w6_out_003 FROM (A>1)#(B>1)
