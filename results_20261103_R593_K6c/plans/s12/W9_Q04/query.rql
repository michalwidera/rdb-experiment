STORAGE 'temp'
SUBSTRAT 'memory'
DECLARE a0 INTEGER, a1 INTEGER, a2 INTEGER, a3 INTEGER, a4 INTEGER, a5 INTEGER, a6 INTEGER, a7 INTEGER, a8 INTEGER, a9 INTEGER, a10 INTEGER, a11 INTEGER, a12 INTEGER, a13 INTEGER, a14 INTEGER, a15 INTEGER STREAM wa, 1/120 TEXTFILE 'wa.txt'
DECLARE b0 INTEGER, b1 INTEGER, b2 INTEGER, b3 INTEGER, b4 INTEGER, b5 INTEGER, b6 INTEGER, b7 INTEGER, b8 INTEGER, b9 INTEGER, b10 INTEGER, b11 INTEGER, b12 INTEGER, b13 INTEGER, b14 INTEGER, b15 INTEGER STREAM wb, 1/60 TEXTFILE 'wb.txt'
SELECT wa[_]*wb[_] STREAM w9_out_000 FROM wa+wb
SELECT wa[_]*wb[_] STREAM w9_out_001 FROM wb+wa
SELECT wa[_]*wb[_] STREAM w9_out_002 FROM wa+wb
SELECT wa[_]*wb[_] STREAM w9_out_003 FROM wb+wa
