 long toNs(const std::timespec &ts) { return (ts.tv_sec * kNanosecondsPerSecond) + ts.tv_nsec; }
 
+// R603 P2 (latka aparatury, nie silnik): grupa szesciu licznikow PMU watku slotu, otwierana przy
+// pierwszej pobudce w watku slotu (pid = 0 liczy tylko watek wolajacy), czytana po pobudce i na
+// koncu slotu. Kolejnosc: L1D_TLB_REFILL, L1I_TLB_REFILL, L2D_CACHE, L2D_CACHE_REFILL,
+// L1D_CACHE_REFILL, INST_RETIRED. Wymaga cap_perfmon (perf_event_paranoid = 4 na workerze).
+constexpr std::array<std::uint64_t, 6> kPmuEvents{0x05, 0x02, 0x16, 0x17, 0x03, 0x08};
+constexpr const char *kPmuColumns =
+    "wake_l1d_tlb_refill,wake_l1i_tlb_refill,wake_l2d_cache,wake_l2d_cache_refill,wake_l1d_cache_refill,wake_inst_retired,"
+    "slot_l1d_tlb_refill,slot_l1i_tlb_refill,slot_l2d_cache,slot_l2d_cache_refill,slot_l1d_cache_refill,slot_inst_retired";
+struct PmuRead {
+  std::uint64_t nr;
+  std::uint64_t enabled;
+  std::uint64_t running;
+  std::array<std::uint64_t, kPmuEvents.size()> v;
+};
+int pmuFd{-2};  // -2 = jeszcze nie otwarte, -1 = niedostepne
+PmuRead pmuPrev{};
+PmuRead pmuWake{};
+bool pmuPrevOk{false};
+bool pmuWakeOk{false};
+
+int pmuOpen() {
+  int leader = -1;
+  for (std::size_t i = 0; i < kPmuEvents.size(); ++i) {
+    perf_event_attr a{};
+    a.size        = sizeof a;
+    a.type        = PERF_TYPE_RAW;
+    a.config      = kPmuEvents[i];
+    a.disabled    = i == 0 ? 1U : 0U;
+    a.exclude_hv  = 1U;
+    a.read_format = PERF_FORMAT_GROUP | PERF_FORMAT_TOTAL_TIME_ENABLED | PERF_FORMAT_TOTAL_TIME_RUNNING;
+    const int fd  = static_cast<int>(::syscall(SYS_perf_event_open, &a, 0, -1, leader, 0));
+    if (fd < 0) {
+      std::println(stderr, "R603 P2: perf_event_open {:#x} nieudane", kPmuEvents[i]);
+      return -1;
+    }
+    if (i == 0) leader = fd;
+  }
+  if (::ioctl(leader, PERF_EVENT_IOC_ENABLE, PERF_IOC_FLAG_GROUP) != 0) return -1;
+  return leader;
+}
+
+// Odczyt wazny tylko bez multipleksowania (enabled == running): inaczej licznik jest przeskalowany.
+bool pmuRead(PmuRead &r) {
+  return pmuFd >= 0 && ::read(pmuFd, &r, sizeof r) == static_cast<ssize_t>(sizeof r) && r.nr == kPmuEvents.size() &&
+         r.enabled == r.running;
+}
+
