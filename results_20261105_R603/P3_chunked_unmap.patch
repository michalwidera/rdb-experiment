+// R603 P3 (latka aparatury, nie silnik): zwolnienie mapowania kolejki w kawalkach 1 MiB, ponizej
+// progu 512 stron, od ktorego munmap na arm64 bez TLBI na zakresach unieważnia TLB calego ASID
+// (flush_tlb_mm). Zakresy mapowania z /proc/self/maps po sciezce pliku kolejki; munmap rosnaco,
+// wiec pierwszy kawalek zaczyna sie od adresu mapowania (okno zwolnienia w parserze sladu).
+// Nastepujacy queue.reset() woła munmap na pustym juz zakresie.
+void unmapQueueInChunks(const std::string &queueName) {
+  constexpr std::uintptr_t kChunk = std::uintptr_t{1} << 20;
+  const std::string suffix        = "/" + queueName;
+  std::vector<std::pair<std::uintptr_t, std::uintptr_t>> ranges;
+  {
+    std::ifstream maps("/proc/self/maps");
+    for (std::string line; std::getline(maps, line);) {
+      if (line.size() < suffix.size() || line.compare(line.size() - suffix.size(), suffix.size(), suffix) != 0) continue;
+      const auto dash = line.find('-');
+      const auto sp   = line.find(' ');
+      if (dash == std::string::npos || sp == std::string::npos || sp < dash) continue;
+      ranges.emplace_back(std::stoull(line.substr(0, dash), nullptr, 16), std::stoull(line.substr(dash + 1, sp - dash - 1), nullptr, 16));
+    }
+  }
+  if (ranges.empty()) SPDLOG_WARN("R603 P3: brak mapowania {} w /proc/self/maps", queueName);
+  for (const auto &[lo, hi] : ranges)
+    for (std::uintptr_t a = lo; a < hi; a += kChunk)
+      if (::munmap(reinterpret_cast<void *>(a), std::min(kChunk, hi - a)) != 0) SPDLOG_WARN("R603 P3: munmap nieudane");
+}
 }  // namespace
 
